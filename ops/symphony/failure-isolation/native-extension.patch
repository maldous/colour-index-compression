diff --git a/elixir/lib/symphony_elixir/failure_isolation.ex b/elixir/lib/symphony_elixir/failure_isolation.ex
new file mode 100644
index 0000000..2870052
--- /dev/null
+++ b/elixir/lib/symphony_elixir/failure_isolation.ex
@@ -0,0 +1,241 @@
+defmodule SymphonyElixir.FailureIsolation do
+  @moduledoc """
+  Versioned failure state stored on the authoritative tracker issue.
+
+  An in-flight record is written and read back before spawning a worker. An
+  orphaned in-flight record after restart requires operator reconciliation.
+  Only an explicit operator progress reference resets a failure streak.
+  """
+
+  @prefix "symphony-failure-v1:"
+
+  @spec read(map() | nil) :: {:ok, map()} | {:error, atom()}
+  def read(nil), do: {:ok, initial()}
+
+  def read(record) do
+    if valid?(record), do: {:ok, record}, else: {:error, :invalid_failure_record}
+  end
+
+  @spec body(map()) :: String.t()
+  def body(record), do: @prefix <> Jason.encode!(record)
+
+  @spec from_comments([map()]) :: {:ok, map()} | {:error, atom()}
+  def from_comments(comments) do
+    Enum.reduce_while(comments, {:ok, []}, fn comment, {:ok, records} ->
+      case Map.get(comment, "body") do
+        @prefix <> json ->
+          case Jason.decode(json) do
+            {:ok, record} ->
+              if valid?(record),
+                do: {:cont, {:ok, [record | records]}},
+                else: {:halt, {:error, :invalid_failure_record}}
+
+            _ ->
+              {:halt, {:error, :invalid_failure_record}}
+          end
+
+        _ ->
+          {:cont, {:ok, records}}
+      end
+    end)
+    |> case do
+      {:ok, records} ->
+        records |> Enum.uniq() |> Enum.sort_by(& &1["sequence"]) |> chain(initial())
+
+      error ->
+        error
+    end
+  end
+
+  defp chain([], record), do: {:ok, record}
+
+  defp chain([next | rest], record) do
+    if next["sequence"] == record["sequence"] + 1 and next["parent"] == record["revision"],
+      do: chain(rest, next),
+      else: {:error, :ambiguous_failure_history}
+  end
+
+  @spec scope(map(), String.t(), String.t()) :: {:ok, map()} | {:error, atom()}
+  def scope(%{"sequence" => 0} = record, issue_id, context) do
+    if is_binary(issue_id) and byte_size(issue_id) in 1..128 and is_binary(context) and
+         byte_size(context) in 1..128,
+       do: {:ok, Map.merge(record, %{"issue_id" => issue_id, "context" => context})},
+       else: {:error, :invalid_failure_context}
+  end
+
+  def scope(%{"issue_id" => issue_id, "context" => context} = record, issue_id, context),
+    do: {:ok, record}
+
+  def scope(_record, _issue_id, _context), do: {:error, :failure_context_changed}
+
+  @spec begin_attempt(map()) :: {:ok, map()} | {:error, atom()}
+  def begin_attempt(%{"status" => "idle"} = record) do
+    {:ok, advance(record, %{"status" => "inflight"})}
+  end
+
+  def begin_attempt(_record), do: {:error, :durable_failure_hold}
+
+  @doc "An operator appends this event only after resolving/fencing the prior attempt."
+  @spec resume(map(), String.t()) :: {:ok, map()} | {:error, atom()}
+  def resume(record, progress_ref) when is_binary(progress_ref) do
+    if byte_size(progress_ref) in 1..128 and progress_ref != record["progress_ref"] do
+      {:ok,
+       advance(record, %{
+         "status" => "idle",
+         "count" => 0,
+         "failure" => nil,
+         "progress_ref" => progress_ref,
+         "failure_progress" => progress_ref
+       })}
+    else
+      {:error, :new_progress_reference_required}
+    end
+  end
+
+  @spec finish(map(), term(), boolean()) :: map() | {:error, atom()}
+  def finish(record, reason, blocked \\ false)
+
+  def finish(%{"status" => "inflight"} = record, reason, blocked) do
+    case identity(reason) do
+      :unconfirmed ->
+        advance(record, %{"status" => "blocked"})
+
+      confirmed ->
+        fingerprint = fingerprint(confirmed)
+
+        same =
+          record["failure"] == fingerprint and
+            record["failure_progress"] == record["progress_ref"]
+
+        count = if same, do: record["count"] + 1, else: 1
+
+        advance(record, %{
+          "failure" => fingerprint,
+          "failure_progress" => record["progress_ref"],
+          "count" => count,
+          "status" =>
+            if(
+              blocked or confirmed == :permission_denied or permission_denied?(reason) or
+                count >= 3,
+              do: "blocked",
+              else: "idle"
+            )
+        })
+    end
+  end
+
+  def finish(_record, _reason, _blocked), do: {:error, :durable_failure_hold}
+
+  @spec continue(map()) :: map() | {:error, atom()}
+  def continue(%{"status" => "inflight"} = record), do: advance(record, %{"status" => "idle"})
+  def continue(_record), do: {:error, :durable_failure_hold}
+
+  @spec permission_denied?(term()) :: boolean()
+  def permission_denied?(reason)
+      when reason in [:permission_denied, :eacces, :eperm, :forbidden, :unauthorized], do: true
+
+  def permission_denied?(reason) when is_tuple(reason),
+    do: reason |> Tuple.to_list() |> Enum.any?(&permission_denied?/1)
+
+  def permission_denied?(reason) when is_list(reason),
+    do: Enum.any?(reason, &permission_denied?/1)
+
+  def permission_denied?(%File.Error{reason: reason}), do: permission_denied?(reason)
+  def permission_denied?(_reason), do: false
+
+  @spec fingerprint(term()) :: String.t()
+  def fingerprint(reason) do
+    # Do not persist/log exception text, paths, tokens, PIDs or timestamps.
+    :crypto.hash(:sha256, :erlang.term_to_binary(reason)) |> Base.encode16(case: :lower)
+  end
+
+  defp identity(%File.Error{reason: reason}), do: [:file_error, reason]
+  defp identity(value) when is_atom(value), do: value
+
+  defp identity({:workspace_hook_failed, hook, status, _output})
+       when hook in ["after_create", "before_run", "after_run", "before_remove"] and
+              is_integer(status),
+       do: [:workspace_hook_failed, hook, status]
+
+  defp identity({:workspace_hook_timeout, hook, _timeout})
+       when hook in ["after_create", "before_run", "after_run", "before_remove"],
+       do: [:workspace_hook_timeout, hook]
+
+  defp identity({:workspace_prepare_failed, host, status, _output}) when is_integer(status),
+    do: [:workspace_prepare_failed, fingerprint(host), status]
+
+  defp identity({:turn_failed, %{"error" => %{"code" => code}}})
+       when code in ["permission_denied", "unauthorized", "forbidden", 401, 403],
+       do: :permission_denied
+
+  defp identity({:port_exit, status}) when is_integer(status), do: [:port_exit, status]
+
+  defp identity({:workspace_path_unreadable, _path, code}) when is_atom(code),
+    do: [:workspace_path_unreadable, code]
+
+  defp identity(value) when is_tuple(value), do: value |> Tuple.to_list() |> identity()
+
+  defp identity(value) when is_list(value) do
+    values = Enum.map(value, &identity/1)
+    if :unconfirmed in values, do: :unconfirmed, else: values
+  end
+
+  defp identity(_value), do: :unconfirmed
+
+  defp initial do
+    %{
+      "version" => 1,
+      "count" => 0,
+      "failure" => nil,
+      "failure_progress" => nil,
+      "progress_ref" => nil,
+      "status" => "idle",
+      "revision" => nil,
+      "parent" => nil,
+      "sequence" => 0,
+      "issue_id" => nil,
+      "context" => nil
+    }
+  end
+
+  defp valid?(
+         %{
+           "version" => 1,
+           "count" => count,
+           "status" => status,
+           "failure" => failure,
+           "failure_progress" => progress,
+           "progress_ref" => reference,
+           "revision" => revision,
+           "parent" => parent,
+           "sequence" => sequence,
+           "issue_id" => issue_id,
+           "context" => context
+         } = record
+       ) do
+    map_size(record) == 11 and is_integer(count) and count >= 0 and
+      status in ["idle", "inflight", "blocked"] and
+      nullable_string?(failure) and nullable_string?(progress) and
+      nullable_string?(reference) and nullable_string?(revision) and nullable_string?(parent) and
+      is_integer(sequence) and sequence >= 0 and nullable_string?(issue_id) and
+      nullable_string?(context)
+  end
+
+  defp valid?(_record), do: false
+
+  defp nullable_string?(value),
+    do: is_nil(value) or (is_binary(value) and byte_size(value) <= 128)
+
+  defp advance(record, changes) do
+    Map.merge(
+      record,
+      Map.merge(changes, %{
+        "parent" => record["revision"],
+        "revision" => nonce(),
+        "sequence" => record["sequence"] + 1
+      })
+    )
+  end
+
+  defp nonce, do: :crypto.strong_rand_bytes(16) |> Base.encode16(case: :lower)
+end
diff --git a/elixir/test/symphony_elixir/failure_isolation_test.exs b/elixir/test/symphony_elixir/failure_isolation_test.exs
new file mode 100644
index 0000000..2cc3bfb
--- /dev/null
+++ b/elixir/test/symphony_elixir/failure_isolation_test.exs
@@ -0,0 +1,183 @@
+defmodule SymphonyElixir.FailureIsolationTest do
+  use ExUnit.Case, async: false
+  alias SymphonyElixir.{FailureIsolation, Linear.Client, Tracker.Issue}
+
+  defp initial do
+    {:ok, record} = FailureIsolation.from_comments([])
+    record
+  end
+
+  defp comment(record), do: %{"body" => FailureIsolation.body(record)}
+
+  defp failed(record, reason) do
+    {:ok, started} = FailureIsolation.begin_attempt(record)
+    {started, FailureIsolation.finish(started, reason)}
+  end
+
+  test "initial failure plus two same confirmed setup failures blocks after restart" do
+    {a, b} = failed(initial(), {:workspace_hook_failed, "before_run", 7, "secret-one"})
+    {:ok, reread} = FailureIsolation.from_comments([comment(a), comment(b)])
+    {c, d} = failed(reread, {:workspace_hook_failed, "before_run", 7, "changed-output"})
+    {e, f} = failed(d, {:workspace_hook_failed, "before_run", 7, "other-output"})
+    {:ok, restarted} = FailureIsolation.from_comments(Enum.map([f, e, d, c, b, a], &comment/1))
+    assert restarted["count"] == 3
+    assert restarted["status"] == "blocked"
+    assert {:error, :durable_failure_hold} = FailureIsolation.begin_attempt(restarted)
+    refute String.contains?(FailureIsolation.body(restarted), "secret")
+  end
+
+  test "normal continuation and runtime messages do not reset streak; distinct status does" do
+    {_a, b} = failed(initial(), {:workspace_hook_failed, "before_run", 7, ""})
+    {:ok, started} = FailureIsolation.begin_attempt(b)
+    continued = FailureIsolation.continue(started)
+    assert continued["count"] == 1
+    {_c, d} = failed(continued, {:workspace_hook_failed, "before_run", 8, ""})
+    assert d["count"] == 1
+    assert d["failure"] != b["failure"]
+  end
+
+  test "typed permission denial blocks immediately without path or exception message" do
+    {_a, b} =
+      failed(initial(), %File.Error{reason: :eacces, path: "/secret/path", action: "read"})
+
+    assert b["status"] == "blocked"
+    assert b["count"] == 1
+    refute String.contains?(FailureIsolation.body(b), "/secret")
+  end
+
+  test "restart never dispatches orphaned inflight or an opaque failure" do
+    {:ok, a} = FailureIsolation.begin_attempt(initial())
+    {:ok, restarted} = FailureIsolation.from_comments([comment(a)])
+    assert {:error, :durable_failure_hold} = FailureIsolation.begin_attempt(restarted)
+
+    b =
+      FailureIsolation.finish(
+        a,
+        {%RuntimeError{message: "token"}, [{__MODULE__, :test, 0, [line: 12]}]}
+      )
+
+    assert b["status"] == "blocked"
+    assert b["count"] == 0
+  end
+
+  test "operator resolution requires new reference; resumes without reviving prior streak" do
+    {_a, b} = failed(initial(), :permission_denied)
+    {:ok, resolved} = FailureIsolation.resume(b, "accepted-resolution-1")
+    assert resolved["count"] == 0
+    assert resolved["status"] == "idle"
+
+    assert {:error, :new_progress_reference_required} =
+             FailureIsolation.resume(resolved, "accepted-resolution-1")
+
+    {_c, d} = failed(resolved, :permission_denied)
+    assert d["count"] == 1
+  end
+
+  test "duplicate event is idempotent; fork, missing parent and malformed state hold" do
+    {:ok, a} = FailureIsolation.begin_attempt(initial())
+    assert {:ok, ^a} = FailureIsolation.from_comments([comment(a), comment(a)])
+    {:ok, other} = FailureIsolation.begin_attempt(initial())
+
+    assert {:error, :ambiguous_failure_history} =
+             FailureIsolation.from_comments([comment(a), comment(other)])
+
+    b = FailureIsolation.continue(a)
+    assert {:error, :ambiguous_failure_history} = FailureIsolation.from_comments([comment(b)])
+
+    assert {:error, :invalid_failure_record} =
+             FailureIsolation.from_comments([%{"body" => "symphony-failure-v1:{}"}])
+  end
+
+  test "invalid scope cannot produce an append; changed issue/source context holds" do
+    assert {:error, :invalid_failure_context} =
+             FailureIsolation.scope(initial(), "id", String.duplicate("x", 129))
+
+    {:ok, scoped} = FailureIsolation.scope(initial(), "id", "source-sha")
+    {:ok, started} = FailureIsolation.begin_attempt(scoped)
+    {:ok, reread} = FailureIsolation.from_comments([comment(started)])
+    assert {:ok, ^reread} = FailureIsolation.scope(reread, "id", "source-sha")
+
+    assert {:error, :failure_context_changed} =
+             FailureIsolation.scope(reread, "different", "source-sha")
+
+    assert {:error, :failure_context_changed} = FailureIsolation.scope(reread, "id", "new-source")
+    denied = FailureIsolation.finish(started, {:turn_failed, %{"error" => %{"code" => 403}}})
+    assert denied["status"] == "blocked"
+    assert denied["count"] == 1
+  end
+
+  test "Linear unknown append outcome resolves by exact readback, never duplicate write" do
+    {:ok, store} = Agent.start_link(fn -> %{comments: [], writes: 0} end)
+    on_exit(fn -> if Process.alive?(store), do: Agent.stop(store) end)
+
+    request = fn payload, _headers ->
+      if String.contains?(payload["query"], "mutation SymphonyFailureRecord") do
+        body = payload["variables"]["input"]["body"]
+
+        Agent.update(store, fn s ->
+          %{s | comments: s.comments ++ [%{"body" => body}], writes: s.writes + 1}
+        end)
+
+        {:error, :simulated_timeout}
+      else
+        comments = Agent.get(store, & &1.comments)
+
+        {:ok,
+         %{
+           status: 200,
+           body: %{
+             "data" => %{
+               "issue" => %{
+                 "comments" => %{"nodes" => comments, "pageInfo" => %{"hasNextPage" => false}}
+               }
+             }
+           }
+         }}
+      end
+    end
+
+    opts = [
+      tracker_settings: %{api_key: "test-only", endpoint: "https://unused.invalid"},
+      request_fun: request
+    ]
+
+    issue = %Issue{id: "test-issue", description: "human text"}
+    {:ok, next} = FailureIsolation.begin_attempt(initial())
+    assert {:ok, ^next} = Client.persist_failure_record(issue, next, opts)
+    assert issue.description == "human text"
+    assert {:ok, _} = Client.persist_failure_record(issue, next, opts)
+    assert Agent.get(store, & &1.writes) == 1
+  end
+
+  test "paginated read reconstructs durable chain and rejects partial GraphQL errors" do
+    {a, b} = failed(initial(), :setup_failed)
+
+    opts = [
+      tracker_settings: %{api_key: "test-only", endpoint: "https://unused.invalid"},
+      request_fun: fn payload, _ ->
+        {nodes, page} =
+          if payload["variables"]["after"] == nil,
+            do: {[comment(b)], %{"hasNextPage" => true, "endCursor" => "page2"}},
+            else: {[comment(a)], %{"hasNextPage" => false}}
+
+        {:ok,
+         %{
+           status: 200,
+           body: %{
+             "data" => %{"issue" => %{"comments" => %{"nodes" => nodes, "pageInfo" => page}}}
+           }
+         }}
+      end
+    ]
+
+    assert {:ok, ^b} = Client.fetch_failure_record(%Issue{id: "test"}, opts)
+
+    bad =
+      Keyword.put(opts, :request_fun, fn _, _ ->
+        {:ok, %{status: 200, body: %{"errors" => [%{"message" => "unknown"}], "data" => nil}}}
+      end)
+
+    assert {:error, :failure_record_unconfirmed} =
+             Client.fetch_failure_record(%Issue{id: "test"}, bad)
+  end
+end

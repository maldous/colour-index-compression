+          {:ok, record}
+
+        current != prior ->
+          {:error, :failure_record_conflict}
+
+        record["parent"] != prior["revision"] or record["sequence"] != prior["sequence"] + 1 ->
+          {:error, :failure_record_conflict}
+
+        true ->
+          # Append once. Unknown mutation outcomes are resolved by exact event
+          # readback, never by blindly repeating a write. No human text changes.
+          graphql(
+            @failure_append,
+            %{"input" => %{"issueId" => id, "body" => FailureIsolation.body(record)}},
+            Keyword.put(opts, :redact_errors, true)
+          )
+
+          case fetch_failure_record(expected, opts) do
+            {:ok, ^record} -> {:ok, record}
+            _ -> {:error, :failure_record_unconfirmed}
+          end
+      end
+    end
+  end

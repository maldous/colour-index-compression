  <page>
    <title>Amiens</title>
    <id>81830</id>
    <revision>
      <id>41966626</id>
      <timestamp>2006-03-02T22:57:44Z</timestamp>
      <contributor>
        <username>Neddyseagoon</username>
        <id>883252</id>

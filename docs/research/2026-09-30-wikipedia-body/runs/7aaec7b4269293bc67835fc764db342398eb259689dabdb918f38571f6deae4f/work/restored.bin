  <page>
    <title>Action Comics</title>
    <id>81284</id>
    <revision>
      <id>40042771</id>
      <timestamp>2006-02-17T18:41:50Z</timestamp>
      <contributor>
        <username>FlaBot</username>
        <id>228773</id>

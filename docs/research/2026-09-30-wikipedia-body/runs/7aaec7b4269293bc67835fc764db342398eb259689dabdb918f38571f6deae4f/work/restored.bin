[[ru:&amp;#1060;&amp;#1072;&amp;#1082;&amp;#1090;&amp;#1086;&amp;#1088;&amp;#1080;&amp;#1079;&amp;#1072;&amp;#1094;&amp;#1080;&amp;#1103;]]

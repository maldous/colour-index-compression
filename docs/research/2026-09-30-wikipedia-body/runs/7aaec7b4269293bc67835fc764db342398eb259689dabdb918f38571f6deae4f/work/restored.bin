      </contributor>
      <comment>/* Places to go */</comment>
      <text xml:space="preserve">{| border=&quot;0&quot; cellpadding=&quot;2&quot; cellspacing=&quot;1&quot; style=&quot;float:right; empty-cells:show; width:330px; margin-left:15px&quot; bgcolor=&quot;#FFDEAD&quot; 

      <text xml:space="preserve">{{Template:US County infobox|
 county  = San Benito County|
 state = California |
 seal = San Benito County ca seal.jpg |
 map = Map of California highlighting San Benito County.png |
 map size = 250|
 founded = [[1874]]|
 seat = [[Hollister, California|Hollister]] | 
 area = 3,602 [[square kilometre|km&amp;sup2;]] (1,391 [[square mile|mi&amp;sup2;]]) |
 area water = 4 km&amp;sup2; (2 mi&amp;sup2;) |
 area percentage = 0.12% |
 census yr = 2000|

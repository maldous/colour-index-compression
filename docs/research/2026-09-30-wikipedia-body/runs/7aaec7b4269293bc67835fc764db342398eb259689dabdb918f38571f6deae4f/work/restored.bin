  <page>
    <title>Sputnik 2</title>
    <id>81978</id>
    <revision>
      <id>39954839</id>
      <timestamp>2006-02-17T01:39:28Z</timestamp>
      <contributor>
        <username>SeanWDP</username>
        <id>510084</id>
      </contributor>
      <minor />
      <comment>Removal of grafitti</comment>
      <text xml:space="preserve">{| class=&quot;toccolours&quot; border=&quot;1&quot; cellpadding=&quot;4&quot; width=&quot;400&quot; style=&quot;float: right; margin: 0 0 1em 1em; border-collapse: collapse; clear: right; font-size:100%;&quot;
|
{{Spacecraft|
  Name = Sputnik 2 |

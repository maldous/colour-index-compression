      <text xml:space="preserve">{| id=&quot;toc&quot; style=&quot;float:right; width:220px; margin-left: 1em;&quot;
|+ style=&quot;font-size: large; margin: inherit;&quot;|'''Brigham Young University'''
|colspan=&quot;2&quot; style=&quot;text-align:center; background:ffffff;&quot;|
{| id=&quot;toc&quot;
|- style=&quot;text-align:center;&quot;
|[[Image:BYU logo.png|100px|Seal of Brigham Young University]]
|- style=&quot;text-align:center;&quot;
|}
|-

  <page>
    <title>Ranger 1</title>
    <id>82253</id>
    <revision>
      <id>35496572</id>
      <timestamp>2006-01-17T03:59:59Z</timestamp>
      <contributor>
        <username>Mike s</username>
        <id>213131</id>
      </contributor>
      <minor />
      <comment>disambiguation UTC</comment>
      <text xml:space="preserve">{| border=&quot;1&quot; cellpadding=&quot;2&quot; cellspacing=&quot;0&quot; align=&quot;right&quot; width=&quot;400&quot; style=&quot;margin:10px&quot; colspan=&quot;2&quot;
|
{{Spacecraft|

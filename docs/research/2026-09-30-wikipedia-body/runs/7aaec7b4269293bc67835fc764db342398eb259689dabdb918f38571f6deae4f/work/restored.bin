      <text xml:space="preserve">{{Template:US County infobox|
 county  = Greene County|
 state = Virginia |
 seal = Greene Seal.gif |
 map = Map of Virginia highlighting Greene County.png |
 map size = 225|
 founded = [[1838]]|
 seat = [[Stanardsville, Virginia|Stanardsville]] | 
 area = 407 [[square kilometre|km&amp;sup2;]] (157 [[square mile|mi&amp;sup2;]]) |
 area water = 1 km&amp;sup2; (0 mi&amp;sup2;) |
 area percentage = 0.25% |
 census yr = 2000|
 pop = 15,244 |

      <contributor>
        <ip>192.55.208.10</ip>
      </contributor>
      <comment>/* Additional Images */</comment>
      <text xml:space="preserve">{{Infobox City |
official_name = Xi'an, [[Shaanxi]], [[China]] |
nickname = [[Chang'an]] |

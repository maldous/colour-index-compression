| OriginOfName   = &amp;#23665; sh&amp;#257;n - mountain &lt;br&gt;&amp;#35199; x&amp;#299; - west &lt;br&gt;&quot;west of the [[Taihang Mountains]]&quot;
| AdministrationType = [[Province of China|Province]]
| Capital = [[Taiyuan]]
| LargestCity    = [[Taiyuan]]
| Secretary      = [[Zhang Baoshun]] 张宝顺
| Governor       = [[Yu Youjun]] 于幼军
| Area           = 156,800
| AreaRank       = 19th
| PopYear        = 2004

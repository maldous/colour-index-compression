  <page>
    <title>Pyruvic acid</title>
    <id>81666</id>
    <revision>
      <id>41489776</id>
      <timestamp>2006-02-27T18:38:13Z</timestamp>
      <contributor>
        <username>Eloy</username>
        <id>522704</id>
      </contributor>
      <minor />
      <comment>+es</comment>
      <text xml:space="preserve">&lt;!-- Here is a table of data; skip past it to edit the text. --&gt;

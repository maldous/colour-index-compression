      <text xml:space="preserve">{{Infobox_Department_of_France|
department=Alpes-Maritimes|number=06|
region=[[Provence-Alpes-Côte d'Azur]]|
prefecture=[[Nice]]|
subprefectures=[[Grasse]]|
population=1,011,326|pop_date=1999|pop_rank=20th|density=235|

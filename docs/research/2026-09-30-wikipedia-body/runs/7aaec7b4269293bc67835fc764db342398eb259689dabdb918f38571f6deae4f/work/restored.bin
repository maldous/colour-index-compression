      <contributor>
        <username>Steve Eifert</username>
        <id>203230</id>
      </contributor>
      <minor />
      <text xml:space="preserve">{{Airport frame}}
{{Airport title|name=Van Nuys Airport}}
&lt;!-- {{Airport image|airport_image= }} --&gt;
{{Airport infobox
 | IATA         = VNY
 | ICAO         = KVNY
 | type         = Public
 | run by       = [[Los Angeles World Airports]]

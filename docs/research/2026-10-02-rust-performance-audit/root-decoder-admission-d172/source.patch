+    let history = u32::from_le_bytes(header[9..13].try_into().unwrap());
+    if block == 0 || block > MAX_BLOCK || history != 0 && history != 65536 {
+        return Err("invalid CIXG header".into());
+    }
+    Ok(CixgHeader { magic, block })

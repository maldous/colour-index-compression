      </contributor>
      <comment>/* Trivia */</comment>
      <text xml:space="preserve">{| class=&quot;eaf-infobox&quot; style=&quot;border: 1px inset #f9f9f9; background-color: #e5e5e5; color: inherit; float: right; margin-left: 1em; width: 200px;&quot;

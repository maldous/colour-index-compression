+        level,
+        backend,
+        backend_set,
+        format,
+        budget,
+        workers,
+        stats,
+        explain,
+    } = selection;
+    if let Some(forced) = forced {
+        let route = match forced {
+            "raw" => 0,
+            "runs" => 1,
+            "composition" => 2,
+            "lz" => 3,
+            "bwt" => 5,
+            "predictor" => 4,

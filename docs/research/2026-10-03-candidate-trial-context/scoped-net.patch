+            "deflate" => 10,
+            _ => return Err(format!("unsupported route: {forced}")),
+        };
+        select_cixg_fixed_route(
+            route,
+            data,
+            backend_set.then_some(backend),
+            format,
+            selector_effort_name(level),
+            budget,
+            workers,
+            stats,
+            explain,
+        )
+    } else {

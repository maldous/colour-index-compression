+fn m6_read_block<R: Read>(src: &mut R, block: &mut [u8]) -> Result<usize, String> {
+    let mut got = 0;
+    while got < block.len() {
+        check_interrupted()?;
+        let n = match src.read(&mut block[got..]) {
+            Ok(n) => n,
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+            Err(error) => return Err(ioerr(error)),
+        };
+        if n == 0 { break; }
+        got += n;
+    }
+    Ok(got)
+}
